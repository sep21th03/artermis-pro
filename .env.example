# ==============================================================================
# ARTEMIS — mẫu cấu hình
# ==============================================================================
# cp .env.example .env   rồi điền giá trị thật.

# --- LLM (bắt buộc) ---
# Key provider thật. Chỉ MÁY CHẠY Mobile Test Console cần key thật; máy tester
# chỉ cần khoá truy cập (xem CONSOLE_ACCESS_KEY bên dưới).
OPENAI_API_KEY=
# Trỏ vào proxy của console để chặn ngân sách (hoặc thẳng nhà cung cấp).
OPENAI_BASE_URL=http://127.0.0.1:8787/llm/v1
# Upstream thật để proxy chuyển tiếp tới (bỏ trống = api.openai.com).
ARTEMIS_UPSTREAM_BASE_URL=
# Khoá truy cập API của Mobile Test Console (apps/test_console): client phải gửi
# khoá này (ARTEMIS gửi OPENAI_API_KEY trong header Authorization) mới gọi được
# /llm/v1. Máy tester chỉ cần 2 dòng:
#   OPENAI_API_KEY=<khoá truy cập>
#   OPENAI_BASE_URL=http://<ip-máy-chạy-console>:8787/llm/v1
CONSOLE_ACCESS_KEY=21092003

# --- Model theo từng chức năng (không khai = dùng mặc định ở trên) ---
# Quy ước: <MODEL>_<CHỨC NĂNG> = <id model>. Xem bảng chức năng trong
# apps/test_console/README.md. Đổi model cho 1 chức năng = sửa đúng 1 dòng này.
# GEMINI35FLASH_OPERATOR=ts/gemini-3.5-flash
# GEMINI35FLASH_EXPLORER=ts/gemini-3.5-flash
# GEMINI35FLASH_PLANNER=ts/gemini-3.5-flash
# GEMINI35FLASH_CHECKER=ts/gemini-3.5-flash
# GEMINIER_OBJECT_DETECTOR=ts/gemini-robotics-er-2-preview   # BẮT BUỘC model ER
# GEMINI35FLASHLITE_HOPPER=ts/gemini-3.5-flash-lite
# GEMINI35FLASHLITE_SUMMARIZER=ts/gemini-3.5-flash-lite

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# ------------------------------------------------------------------------------
# Remote ADB server (DEV machine + tester machine with the phone on USB)
# ------------------------------------------------------------------------------
# On the tester machine:  adb -a -P 5037 nodaemon server
# On this machine set:    ADB_HOST=<tester-lan-ip>   ADB_PORT=5037
# Verify with:            artemis adb check
# Never expose the ADB server to the internet: LAN/VPN + firewall only.
# The Accessibility Helper is skipped automatically with a remote server
# (`adb forward` binds on the tester's loopback); set ARTEMIS_ALLOW_REMOTE_HELPER=1
# only when the forward port is reachable anyway (e.g. through an SSH tunnel).
# ARTEMIS_ALLOW_REMOTE_HELPER=0
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# Sau khi hết retry LLM, task chờ tối đa bao lâu ở trạng thái "paused" rồi bỏ cuộc.
# ARTEMIS mặc định 900s (15 phút) — quá lâu, tester tưởng task bị treo.
LLM_PAUSE_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# Knowledge base — Workflow RAG (tuỳ chọn)
# ------------------------------------------------------------------------------
# Cho agent biết sẵn đường dẫn thao tác của từng chức năng, thay vì tự mò.
# BỎ TRỐNG ARTEMIS_KB_DSN = tắt tính năng; ARTEMIS chạy y như trước, không lỗi.
#
# Cách 1 — PostgreSQL trên VPS (khuyến nghị: chỉ một máy cần cài database).
#   Trên VPS:  apt install postgresql-14-pgvector   (thêm repo PGDG trước)
#   Máy dev mở tunnel:   sh scripts/kb_tunnel.sh start
#   rồi trỏ DSN vào cổng tunnel — cổng 5432 trên VPS vẫn ĐÓNG với Internet:
#     ARTEMIS_KB_DSN=postgresql://<user>:<mat-khau>@127.0.0.1:5433/artemis_kb
#   Máy tester KHÔNG cần DSN, chỉ cần ARTEMIS_KB_API (xem mục cuối file này).
#
# Cách 2 — PostgreSQL ngay trên máy này:
#   brew install pgvector && createdb artemis_kb
#   uv pip install 'psycopg[binary]' pgvector
#   psql -d artemis_kb -c 'CREATE EXTENSION IF NOT EXISTS vector; CREATE EXTENSION IF NOT EXISTS pg_trgm;'
# Schema tự tạo khi console/server khởi động lần đầu.
#
# ARTEMIS_KB_DSN=postgresql://<user>@localhost:5432/artemis_kb

# Model tạo embedding. Đổi model = phải chạy lại POST /api/kb/reindex.
ARTEMIS_KB_EMBEDDING_MODEL=gemini-embedding-2
# Cắt bớt số chiều (Matryoshka). Bỏ trống = giữ nguyên độ rộng gốc của model.
# ARTEMIS_KB_EMBEDDING_DIM=768
# Số workflow tối đa đưa vào prompt sau khi xếp hạng.
ARTEMIS_KB_TOP_K=3
# Hằng số RRF (bài báo gốc dùng 60). Không cần chỉnh trừ khi đo thấy kém.
ARTEMIS_KB_RRF_K=60
# Trần ký tự của khối kiến thức chèn vào prompt Planner.
ARTEMIS_KB_CONTEXT_MAX_CHARS=4000
# Tỉ lệ từ khoá nội dung mà một workflow phải khớp để được coi là bằng chứng.
# Đo thực tế: yêu cầu thật đạt 1.0; ca dương tính giả "chụp màn hình" đạt 0.5.
ARTEMIS_KB_KEYWORD_MIN_COVERAGE=0.6
# ARTEMIS_KB_ENABLED=1

# ------------------------------------------------------------------------------
# Vai trò của console (chỉ cần đặt khi một máy làm nhiệm vụ riêng)
# ------------------------------------------------------------------------------
#   (bỏ trống) = all  — máy dev chạy một mình: điều khiển thiết bị + AI proxy + RAG
#                       + quản trị KB. Đây là mặc định, giữ nguyên hành vi cũ.
#   server           — máy chủ dùng chung (VPS): CHỈ AI proxy + API RAG.
#                       Không đăng ký endpoint điều khiển thiết bị, không có giao
#                       diện, không có /api/kb/*. Bắt buộc khi mở ra Internet:
#                       POST /api/run chạy `artemis run`, để lộ là lỗ hổng thực thi
#                       lệnh, và /api/kb/* xoá được workflow mà không có khoá riêng.
#   edge             — máy cắm điện thoại: điều khiển thiết bị + giao diện, KHÔNG
#                       giữ key LLM thật (LLM và kiến thức đều hỏi máy chủ).
# CONSOLE_ROLE=server

# ------------------------------------------------------------------------------
# Máy tester: chỉ cài ARTEMIS, không cài PostgreSQL (tuỳ chọn)
# ------------------------------------------------------------------------------
# Đặt ARTEMIS_KB_API = máy này KHÔNG cần database, không cần khoá embedding, không
# cần GEMINI_API_KEY. Trước mỗi lần chạy, ARTEMIS gửi prompt gốc tới console
# (POST /api/knowledge/context) và nhận về **prompt hoàn chỉnh**: prompt gốc ghép
# với hướng dẫn của workflow khớp nhất trong knowledge base.
#
# Console phải mở cổng cho LAN (hoặc đặt sau nginx có TLS nếu đi qua Internet):
#   ARTEMIS_WEB_HOST=0.0.0.0 sh apps/test_console/run.sh
#
# ARTEMIS_KB_API=http://<ip-máy-chạy-console>:8787
# ARTEMIS_KB_API_KEY=21092003
# ARTEMIS_KB_API_TIMEOUT=20
#
# Chú ý: ARTEMIS gửi kèm `User-Agent: ARTEMIS/1.0`. Cloudflare (nếu console đi qua
# nó) chặn UA mặc định của Python bằng lỗi 1010 — đo được 403 với `Python-urllib/3.x`
# và 200 với UA này.

